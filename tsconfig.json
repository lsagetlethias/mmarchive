{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@mmarchive/shared": ["./packages/shared/src/index.ts"],
      "@mmarchive/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/*.config.ts",
    "tests/**/*.ts",
    "eslint.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "packages/*/dist"]
}
