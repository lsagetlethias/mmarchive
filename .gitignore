# Secrets - JAMAIS dans le repo
.env
.env.*
!.env.example

# Archives extraites - volumineuses et contenant des echanges internes.
# Le motif couvre tout repertoire commencant par "archive" (archive-essai,
# archive-2026-08, etc.) : une archive de test contient exactement les memes
# donnees qu une archive de production.
archive/
archive*/
manifest.json
.extract-state.json
*.ndjson
index.db
index.db-*

# Fichier de selection genere (contient la topologie de l instance)
channels.yaml
channels.*.yaml

# Build output
dist/
*.tsbuildinfo

# Dependances
node_modules/

# IDE / OS
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Caches
.cache/
.eslintcache
.turbo/
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
