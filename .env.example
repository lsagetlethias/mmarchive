# mmarchive - configuration d extraction
# Copier vers .env :  cp .env.example .env
# Le .env n est jamais lu par l assistant (hook PreToolUse) et jamais commite.

# URL de base de l instance Mattermost, sans slash final.
MM_URL=https://mattermost.example.org

# Token porteur. Trois provenances possibles, toutes utilisees en Authorization: Bearer <token> :
#  1. Session token   : DevTools > Application > Cookies > MMAUTHTOKEN
#  2. Personal Access Token : Profil > Security > Personal Access Tokens (si active par l admin)
#  3. Token de bot    : System Console > Integrations > Bot Accounts
MM_TOKEN=

# Optionnel : repertoire de sortie par defaut.
# MM_ARCHIVE_OUT=./archive
